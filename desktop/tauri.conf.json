{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markpad",
  "version": "2.3.0",
  "identifier": "io.github.cc666debug.markpad",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "A slim Markdown editor",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["md", "markdown", "mdown", "mkd"], "name": "Markdown", "description": "Markdown document", "mimeType": "text/markdown", "role": "Editor" }
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
